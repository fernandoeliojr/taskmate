@page
@model TaskMate.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Perfil do Usuário";
}

<div class="container mt-4">
    <h2 class="mb-3">Meu Perfil</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Nome</label>
            <input asp-for="AppUser.Nome" class="form-control" />
            <span asp-validation-for="AppUser.Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">E-mail</label>
            <input asp-for="AppUser.Email" class="form-control" readonly />
        </div>

        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        <a asp-page="/Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
