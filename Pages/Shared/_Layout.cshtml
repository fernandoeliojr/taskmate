@{
    var appName = "TaskMate";
}
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @appName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body class="d-flex flex-column min-vh-100">
    <header class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-light" asp-page="/Index">@appName</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Profile">👤 @User.Identity.Name</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Tasks/Index">📋 Tarefas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Tasks/ReportsOptions">📑 Relatórios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Logout">🚪 Sair</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Login">🔐 Entrar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Register">📝 Registrar</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </header>

    <main class="container mt-4 pb-3" role="main">
        @RenderBody()
    </main>

    <footer class="footer bg-dark mt-5 border-top text-light py-3 mt-auto">
        <div class="container text-center">
            <span>&copy; @(DateTime.Now.Year) - @appName</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>