@page
@model TaskMate.Pages.Tasks.Index
@{
    ViewData["Title"] = "Minhas Tarefas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📋 Minhas Tarefas</h2>
</div>

<form method="get" class="row mb-4" id="pesquisa">
    <div class="col-md-5">
        <input type="text" name="searchTitulo" value="@Model.SearchTitulo" class="form-control"
            placeholder="Pesquisar por Título..." />
    </div>
    <div class="col-md-4">
        <select name="searchStatus" class="form-select">
            <option value="">Todos os Status</option>
            <option value="A Fazer" selected="@(Model.SearchStatus == "A Fazer")">A Fazer</option>
            <option value="Em Progresso" selected="@(Model.SearchStatus == "Em Progresso")">Em Progresso</option>
            <option value="Concluída" selected="@(Model.SearchStatus == "Concluída")">Concluída</option>
        </select>
    </div>
    <div class="col-md-3 d-flex">
        <button type="submit" class="btn btn-primary">🔍 Pesquisar</button>
    </div>
</form>


@if (Model.TaskItem.Count == 0)
{
    <div class="alert alert-info">Nenhuma tarefa cadastrada ainda.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Descrição</th>
                <th>Status</th>
                <th style="width:200px">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model.TaskItem)
            {
                <tr>
                    <td>@task.Titulo</td>
                    <td>@task.Descricao</td>
                    <td>
                        @if (task.Status == "Concluída")
                        {
                            <span class="badge bg-success">@task.Status</span>
                        }
                        else if (task.Status == "Em Progresso")
                        {
                            <span class="badge bg-warning text-dark">@task.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@task.Status</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-page="./Edit" asp-route-id="@task.Id">Editar</a>
                        <a class="btn btn-sm btn-danger" asp-page="./Delete" asp-route-id="@task.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
    <div class="mt-3">
        <a class="btn btn-primary" asp-page="./Create">Nova Tarefa</a>
    </div>
}